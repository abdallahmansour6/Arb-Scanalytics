[Unit]
Description=Arb Scanalytics — Streamlit dashboard
After=network-online.target arb-collector.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
WorkingDirectory=/opt/Arb-Scanalytics
# Invoke streamlit via the venv's python -m so we don't depend on PATH
ExecStart=/opt/Arb-Scanalytics/.venv/bin/python -m streamlit run dashboard.py \
    --server.address=0.0.0.0 \
    --server.port=8501 \
    --server.headless=true
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
# Defensive belt — the dashboard's narrow-file-list snapshot path stays
# well under 1024 open files, but a future scale-out (more venues, denser
# cadence, deeper fallback K) shouldn't hit the default ulimit cliff.
# 65536 matches systemd's modern recommended ceiling for service units.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
