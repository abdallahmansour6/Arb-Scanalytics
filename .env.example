# Arb-Scanalytics — environment variables.
#
# Copy this file to `.env` (which is gitignored) on each machine where
# the scanner runs, and fill in the real values. The collector and
# liveness ping pick these up automatically.
#
# These are scanner-local credentials — independent of any other
# project's .env. If you ever rename or move the engine, the scanner
# is unaffected.

# Pushover credentials — used by liveness_ping.sh to alert on collector
# stalls. Get them from https://pushover.net/ (your user key + an
# application token you create for this scanner).
PUSHOVER_TOKEN=
PUSHOVER_USER=
